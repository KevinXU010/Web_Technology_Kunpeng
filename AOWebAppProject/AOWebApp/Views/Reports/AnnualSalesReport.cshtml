@model SelectList
@using Microsoft.AspNetCore.Mvc.Rendering

<div class="bg-light py-2 mb-2">
    <h2 class="text-center">Annual Sales Report</h2>
</div>

<div class="row mb-3">
    <div class="col-3">
        <label for="reportSelect" class="form-label">Year</label>
        <select id="reportSelect" name="year" asp-items="@Model" class="form-select">
            <option value="">Select...</option>
        </select>
    </div>
</div>


<svg id="chart" width="100%" height="400px" class="border border-primary rounded p-2"></svg>

@section Scripts {
    <script type="module">
            import * as d3 from "https://cdn.jsdelivr.net/npm/d3@7/+esm";

            //Select SVG and calculate the drawing area size
            const svg = d3.select('#chart');
            const { width: w, height: h } = svg.node().getBoundingClientRect();
            const margin = { top: 20, right: 20, bottom: 40, left: 60 };
            const innerW = w - margin.left - margin.right;
            const innerH = h - margin.top - margin.bottom;

             //Drop-down change event
            const selectEl = document.querySelector('#reportSelect');
            const dataUrl  = '@Url.Action("AnnualSalesReportData", "Reports")';

            selectEl.addEventListener('change', (event) => {
              const year = event.target.value;
              if (!year) return;

              
              fetch(`${dataUrl}?year=${encodeURIComponent(year)}`)
                .then(resp => {
                  console.log('response status:', resp.status, resp.statusText);
                  return resp.json();
                })
                .then(data => buildGraph(data))      
                .catch(err => console.error(err));
            });


            function buildGraph(dataSet) {
            //Size and Margins
              const { width: svgW, height: svgH } = svg.node().getBoundingClientRect();
              const chartMargins = { left: 40, right: 25, top: 25, bottom: 80 };
              const innerW = svgW - (chartMargins.left + chartMargins.right);
              const innerH = svgH - (chartMargins.top + chartMargins.bottom);

             //Scale
              const maxTotalItems = d3.extent(dataSet, d => d.totalItems ?? 0)?.[1] ?? 0;

              const yScale = d3.scaleLinear()
                .domain([0, maxTotalItems])
                .range([innerH, 0]);

              const fmtMonth = d3.timeFormat('%b'); 
              const monthNameOf = d => d.monthName ?? fmtMonth(new Date(2000, (d.monthNo ?? 1) - 1, 1));
              const monthArray  = Array.from(dataSet, d => monthNameOf(d));

              const xScale = d3.scaleBand()
                .domain(monthArray)
                .range([0, innerW])
                .paddingInner(0.10);

              //Create chartGroup
              svg.selectAll('*').remove();
              const chartGroup = svg.append('g')
                .attr('class', 'chartGroup')
                .attr('transform', `translate(${chartMargins.left},${chartMargins.top})`);

             //Generate barGroups
              const barGroups = chartGroup
                .selectAll('g.bar')
                .data(dataSet, d => d.monthNo);

              //Enter to x,y
              const barEnter = barGroups.enter()
                .append('g')
                .attr('class', 'bar')
                .attr('transform', d => `translate(${xScale(monthNameOf(d))}, ${yScale(d.totalItems)})`);

              // Location Update 
              barGroups
                .transition().duration(600)
                .attr('transform', d => `translate(${xScale(monthNameOf(d))}, ${yScale(d.totalItems)})`);

              
              barGroups.exit()
                .transition().duration(400)
                .style('opacity', 0)
                .remove();


              //Draw transparently when entering
              barEnter.append('rect')
                .attr('x', 0)
                .attr('width', xScale.bandwidth())
                .attr('y', d => innerH - yScale(d.totalItems))   
                .attr('height', 0)                                
                .style('fill', 'transparent')
                .transition().duration(800).delay((d, i) => i * 120)
                  .attr('y', 0)                                   
                  .attr('height', d => innerH - yScale(d.totalItems))
                  .style('fill', d => `hsl(240, 100%, ${100 - (d.totalItems / maxTotalItems * 80)}%)`);

              //Existing rectangle with transition and coloring
              barGroups.select('rect')
                .transition().duration(600)
                  .attr('x', 0)
                  .attr('width', xScale.bandwidth())
                  .attr('y', 0)
                  .attr('height', d => innerH - yScale(d.totalItems))
                  .style('fill', d => `hsl(240, 100%, ${100 - (d.totalItems / maxTotalItems * 80)}%)`);

               // White text value at the top, fades in when entering
              barEnter.append('text')
                .attr('text-anchor', 'middle')
                .attr('x', xScale.bandwidth() / 2)
                .attr('y', 20)
                .attr('fill', 'white')
                .style('font-size', '1em')
                .style('opacity', 0)
                .text(d => d.totalItems.toLocaleString())
                .transition().duration(500).delay((d, i) => i * 120 + 300)
                  .style('opacity', 1);

              //Update the text when updating the year
              barGroups.select('text')
                .transition().duration(600)
                  .attr('x', xScale.bandwidth() / 2)
                  .text(d => d.totalItems.toLocaleString());

             //Axis :clear the old before drawing the new
              chartGroup.selectAll('g.axis.y').remove();
              chartGroup.selectAll('g.axis.x').remove();

              const yAxis = d3.axisLeft(yScale).ticks(6).tickFormat(d3.format('~s'));
              chartGroup.append('g').attr('class', 'axis y').call(yAxis);

              const xAxis = d3.axisBottom(xScale).tickSizeOuter(0);
              chartGroup.append('g')
                .attr('class', 'axis x')
                .attr('transform', `translate(0, ${innerH})`)
                .call(xAxis);

            }


    </script>
}




   